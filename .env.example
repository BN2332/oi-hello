# API_BASE="" keeps the API same-origin. Set VITE_API_BASE only when the API is on another origin.
VITE_API_BASE=

# Server-side Supabase Auth settings. Never expose service_role keys.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Exact public origin of the frontend when using a separate API origin.
SITE_URL=http://localhost:3000
