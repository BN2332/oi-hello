# Canais oficiais de atendimento.
# Sem estes valores o formulário NÃO simula envio: ele gera um briefing
# formatado, oferece cópia para a área de transferência e informa o estado.

# E-mail oficial de contato (destino do formulário)
VITE_CONTACT_EMAIL=

# WhatsApp oficial em formato internacional, apenas dígitos (ex.: 5511999999999)
VITE_WHATSAPP_NUMBER=

# Convite oficial do Discord (ex.: https://discord.gg/xxxxxxx)
VITE_DISCORD_INVITE=

# URL pública do site (usada em metadados de compartilhamento)
VITE_SITE_URL=
