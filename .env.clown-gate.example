# Clown Gate — configure only in the hosting provider's secret manager.
NODE_ENV=production
APP_URL=https://your-domain.example

# Supabase project URL + SERVICE ROLE key (never expose to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Private API access for trusted server-to-server integrations.
# Generate a random secret with at least 32 bytes of entropy.
CLOWNGATE_API_SECRET=

# Asaas: sandbox is the default. Use production only after account approval and homologation.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Safety limit in cents. Default: R$ 10.000,00.
MAX_PIX_AMOUNT_CENTS=1000000
